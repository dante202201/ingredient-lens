# 复制为 .env 并填入实际值（.env 不要提交到 Git）

# 管理后台 Token（生产环境必填；本地开发可不设）
ADMIN_TOKEN=

# OCR 提供商: ali（官方 SDK，默认）| tysbgpu（市场 AppCode）
OCR_PROVIDER=ali

# 阿里云官方 OCR（OCR_PROVIDER=ali 时必填）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALI_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
# ALI_OCR_TYPE=Advanced

# 阿里云市场 OCR（OCR_PROVIDER=tysbgpu 时必填）
OCR_APPCODE=
# OCR_API_URL=https://tysbgpu.market.alicloudapi.com/api/predict/ocr_general

# 可选：图片 OSS 域名（相对路径 image_url 会拼在此域名后）
# OSS_DOMAIN=https://your-bucket.oss-cn-beijing.aliyuncs.com/

# 可选：允许跨域的前端地址，逗号分隔（默认已含 localhost:8080 等）
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
